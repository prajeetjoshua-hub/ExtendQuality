# Frontend
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Backend
EXTENDQUALITY_ENVIRONMENT=development
EXTENDQUALITY_API_HOST=127.0.0.1
EXTENDQUALITY_API_PORT=8000
EXTENDQUALITY_DATABASE_PATH=storage/metadata/extendquality.db
EXTENDQUALITY_STORAGE_PATH=storage
EXTENDQUALITY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
EXTENDQUALITY_MAX_UPLOAD_BYTES=10485760
EXTENDQUALITY_YOLO_WEIGHTS=models/weights/best.pt
EXTENDQUALITY_YOLO_CONFIDENCE=0.35
EXTENDQUALITY_DECISION_CONFIDENCE=0.65
EXTENDQUALITY_RECAPTURE_QUALITY=0.45

# Added later when the VLM adapter is selected.
EXTENDQUALITY_VLM_PROVIDER=demo
EXTENDQUALITY_VLM_API_KEY=
